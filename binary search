#include <iostream>
using namespace std;

int main() {
    int a[]={10,20,30,40,50}, n=5, key=30;
    int low=0, high=n-1, mid;

    while(low<=high) {
        mid=(low+high)/2;

        if(a[mid]==key) {
            cout<<"Element Found";
            return 0;
        }
        else if(a[mid]<key) low=mid+1;
        else high=mid-1;
    }

    cout<<"Element Not Found";
}
