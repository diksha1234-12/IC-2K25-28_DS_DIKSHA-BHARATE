#include <iostream>
using namespace std;

int main() {
    int a[4][4] = {0};
    int u, v;

    for(int i=0; i<4; i++) {
        cin >> u >> v;
        a[u][v] = 1;
        a[v][u] = 1;
    }

    for(int i=0; i<4; i++) {
        for(int j=0; j<4; j++)
            cout << a[i][j] << " ";
        cout << endl;
    }
}
