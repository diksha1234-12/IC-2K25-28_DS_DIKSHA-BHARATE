#include <iostream>
using namespace std;

struct Node {
    int data;
    Node *left, *right;
    Node(int x) {
        data = x;
        left = right = NULL;
    }
};

Node* insert(Node* r, int x) {
    if (!r) return new Node(x);
    if (x < r->data) r->left = insert(r->left, x);
    else if (x > r->data) r->right = insert(r->right, x);
    return r;
}

bool search(Node* r, int x) {
    if (!r) return false;
    if (r->data == x) return true;
    return x < r->data ? search(r->left, x) : search(r->right, x);
}

int minimum(Node* r) {
    while (r->left) r = r->left;
    return r->data;
}

int maximum(Node* r) {
    while (r->right) r = r->right;
    return r->data;
}

int main() {
    Node* root = NULL;
    root = insert(root, 50);
    root = insert(root, 30);
    root = insert(root, 70);

    cout << "Search 30: " << search(root, 30);
    cout << "\nMinimum: " << minimum(root);
    cout << "\nMaximum: " << maximum(root);
}
