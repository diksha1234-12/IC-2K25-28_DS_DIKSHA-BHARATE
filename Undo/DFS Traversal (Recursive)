#include <iostream>
#include <vector>
using namespace std;

vector<int> g[5];
bool visited[5] = {};

void DFS(int u) {
    visited[u] = true;
    cout << u << " ";

    for(int v : g[u])
        if(!visited[v])
            DFS(v);
}

int main() {
    g[0] = {1, 2};
    g[1] = {0, 3};
    g[2] = {0, 4};

    DFS(0);
}
