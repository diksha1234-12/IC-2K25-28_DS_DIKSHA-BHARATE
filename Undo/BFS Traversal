#include <iostream>
#include <vector>
#include <queue>
using namespace std;

int main() {
    vector<int> g[5];
    g[0] = {1, 2};
    g[1] = {0, 3};
    g[2] = {0, 4};

    bool visited[5] = {};
    queue<int> q;

    q.push(0);
    visited[0] = true;

    while(!q.empty()) {
        int u = q.front();
        q.pop();
        cout << u << " ";

        for(int v : g[u]) {
            if(!visited[v]) {
                visited[v] = true;
                q.push(v);
            }
        }
    }
}
