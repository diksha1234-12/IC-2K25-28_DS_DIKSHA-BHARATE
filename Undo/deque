#include <iostream>
#include <deque>
using namespace std;

int main() {
    deque<int> dq;

    dq.push_front(10);
    dq.push_back(20);
    dq.push_front(5);

    cout << "Deque: ";
    for (int x : dq)
        cout << x << " ";

    dq.pop_front();
    dq.pop_back();

    cout << "\nAfter deletion: ";
    for (int x : dq)
        cout << x << " ";
}
