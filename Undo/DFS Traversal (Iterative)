#include <iostream>
#include <vector>
#include <stack>
using namespace std;

int main() {
    vector<int> g[5];
    g[0] = {1, 2};
    g[1] = {0, 3};
    g[2] = {0, 4};

    bool visited[5] = {};
    stack<int> s;

    s.push(0);

    while(!s.empty()) {
        int u = s.top();
        s.pop();

        if(visited[u]) continue;

        visited[u] = true;
        cout << u << " ";

        for(int v : g[u])
            if(!visited[v])
                s.push(v);
    }
}
