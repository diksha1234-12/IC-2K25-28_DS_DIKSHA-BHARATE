#include <iostream>
#include <stack>
using namespace std;

int main() {
    stack<int> s;
    string exp = "23+";

    for (char c : exp) {
        if (isdigit(c)) s.push(c - '0');
        else {
            int b = s.top(); s.pop();
            int a = s.top(); s.pop();

            if (c == '+') s.push(a + b);
            if (c == '-') s.push(a - b);
            if (c == '*') s.push(a * b);
            if (c == '/') s.push(a / b);
        }
    }

    cout << "Result: " << s.top();
}
