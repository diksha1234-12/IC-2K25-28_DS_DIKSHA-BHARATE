#include <iostream>
using namespace std;

struct Node {
    int data;
    Node *next;
};

Node *front = NULL, *rear = NULL;

void enqueue(int x) {
    Node *n = new Node{x, NULL};
    if (!rear) front = rear = n;
    else {
        rear->next = n;
        rear = n;
    }
}

void dequeue() {
    if (!front) cout << "Queue Empty";
    else {
        Node *t = front;
        cout << "Deleted: " << t->data;
        front = front->next;
        if (!front) rear = NULL;
        delete t;
    }
}

int main() {
    enqueue(10);
    enqueue(20);
    enqueue(30);
    dequeue();
}
