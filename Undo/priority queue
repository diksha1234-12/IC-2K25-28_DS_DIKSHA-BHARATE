#include <iostream>
using namespace std;

int main() {
    int q[5] = {30, 10, 50, 20, 40};
    int n = 5;

    for (int i = 0; i < n; i++)
        for (int j = i + 1; j < n; j++)
            if (q[i] < q[j])
                swap(q[i], q[j]);

    cout << "Priority Queue: ";
    for (int i = 0; i < n; i++)
        cout << q[i] << " ";

    cout << "\nDeleted: " << q[0];
}
