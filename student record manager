#include <iostream>
#include <algorithm>
using namespace std;

struct Student {
    int roll;
    string name;
    float marks;
};

int main() {
    Student s[3]={{3,"Amit",75},{1,"Riya",90},{2,"Neha",85}};

    sort(s,s+3,[](Student a,Student b) {
        return a.marks>b.marks;
    });

    cout<<"Student Records:\n";
    for(int i=0;i<3;i++)
        cout<<s[i].roll<<" "<<s[i].name
            <<" "<<s[i].marks<<endl;
}
