#include <iostream>
using namespace std;

int main() {
    int a[] = {5, 2, 8, 1, 3}, n = 5;

    for(int i=1; i<n; i++) {
        int key = a[i], j = i-1;
        while(j>=0 && a[j]>key) {
            a[j+1] = a[j];
            j--;
        }
        a[j+1] = key;
    }

    for(int x : a) cout << x << " ";
    return 0;
}
