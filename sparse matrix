
#include <iostream>
using namespace std;

int main()
{
    int rows, cols;

    cout << "Enter number of rows: ";
    cin >> rows;

    cout << "Enter number of columns: ";
    cin >> cols;

    int matrix[20][20];

    cout << "Enter matrix elements:\n";

    for(int i = 0; i < rows; i++)
    {
        for(int j = 0; j < cols; j++)
        {
            cin >> matrix[i][j];
        }
    }

    int count = 0;

    // Count non-zero elements
    for(int i = 0; i < rows; i++)
    {
        for(int j = 0; j < cols; j++)
        {
            if(matrix[i][j] != 0)
                count++;
        }
    }

    // Sparse matrix representation
    int sparse[400][3];
    int k = 1;

    sparse[0][0] = rows;
    sparse[0][1] = cols;
    sparse[0][2] = count;

    for(int i = 0; i < rows; i++)
    {
        for(int j = 0; j < cols; j++)
        {
            if(matrix[i][j] != 0)
            {
                sparse[k][0] = i;
                sparse[k][1] = j;
                sparse[k][2] = matrix[i][j];
                k++;
            }
        }
    }

    cout << "\nSparse Matrix (Triplet Form):\n";
    cout << "Row\tColumn\tValue\n";

    for(int i = 0; i <= count; i++)
    {
        for(int j = 0; j < 3; j++)
        {
            cout << sparse[i][j] << "\t";
        }
        cout << endl;
    }

    // Space analysis
    int normalSpace = rows * cols;
    int sparseSpace = (count + 1) * 3;

    cout << "\nSpace Analysis:\n";

    cout << "Normal Matrix Space: "
         << normalSpace << " elements\n";

    cout << "Sparse Matrix Space: "
         << sparseSpace << " elements\n";

    cout << "Space Saved: "
         << normalSpace - sparseSpace
         << " elements\n";

    if(normalSpace > 0)
    {
        float saving = 
        ((float)(normalSpace - sparseSpace)
        / normalSpace) * 100;

        cout << "Space Saving: "
             << saving << "%\n";
    }

    return 0;
}

