#include <iostream>
#include <unordered_map>
#include <algorithm>
using namespace std;

int main() {
    string words[]={"apple","mango","banana","grapes"};
    int n=4;

    sort(words,words+n);

    string key="mango";

    if(binary_search(words,words+n,key))
        cout<<"Found using Binary Search\n";

    unordered_map<string,int> hash;

    for(int i=0;i<n;i++)
        hash[words[i]]=i;

    if(hash.find(key)!=hash.end())
        cout<<"Found using Hashing";
}
