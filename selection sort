#include <iostream>
using namespace std;

int main() {
    int a[] = {5, 2, 8, 1, 3}, n = 5;

    for(int i=0; i<n-1; i++) {
        int min = i;
        for(int j=i+1; j<n; j++)
            if(a[j] < a[min]) min = j;
        swap(a[i], a[min]);
    }

    for(int x : a) cout << x << " ";
    return 0;
}
