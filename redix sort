#include <iostream>
using namespace std;

int main() {
    int a[]={170,45,75,90,802,24,2,66}, n=8;
    int output[8], max=a[0];

    for(int x:a) if(x>max) max=x;

    for(int exp=1; max/exp>0; exp*=10) {
        int count[10]={0};

        for(int i=0;i<n;i++)
            count[(a[i]/exp)%10]++;

        for(int i=1;i<10;i++)
            count[i]+=count[i-1];

        for(int i=n-1;i>=0;i--)
            output[--count[(a[i]/exp)%10]]=a[i];

        for(int i=0;i<n;i++) a[i]=output[i];
    }

    for(int x:a) cout<<x<<" ";
}
