#include <iostream>
using namespace std;

int st[100], top = -1;

void push(int x) {
    if (top == 99) cout << "Overflow\n";
    else st[++top] = x;
}

void pop() {
    if (top == -1) cout << "Underflow\n";
    else cout << "Deleted: " << st[top--] << endl;
}

void display() {
    for (int i = top; i >= 0; i--)
        cout << st[i] << " ";
}

int main() {
    push(10);
    push(20);
    push(30);
    display();
    pop();
    return 0;
}
